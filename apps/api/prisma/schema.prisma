// docs/padroes/banco.md: @@map e @map em todo modelo e campo (P3); nada se apaga (P2).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Dono: raiz do agregado (P1). Limites iguais aos de OWNER_LIMITS (P3, P6).
model Owner {
  id        Int      @id @default(autoincrement()) @map("id")
  firstName String   @map("first_name") @db.VarChar(30)
  lastName  String   @map("last_name") @db.VarChar(30)
  address   String   @map("address") @db.VarChar(255)
  city      String   @map("city") @db.VarChar(80)
  /// E.164 (D05)
  telephone String   @map("telephone") @db.VarChar(14)
  /// Só dígitos (D13); único enquanto presente, por índice parcial em SQL cru (D15)
  cpf                String?   @map("cpf") @db.Char(11)
  email              String?   @map("email") @db.VarChar(254)
  /// Data do consentimento de mensagens; nulo significa sem consentimento (D12)
  messagingConsentAt DateTime? @map("messaging_consent_at") @db.Timestamptz(3)
  /// CA-3.2: o aviso de dono parecido foi visto e dispensado nesta data (D14)
  similarityDismissedAt DateTime? @map("similarity_dismissed_at") @db.Timestamptz(3)
  version   Int      @default(0) @map("version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pets Pet[]

  @@map("owners")
}

/// D16/P-25: resultado da primeira execução de cada gravação, repetido para a mesma chave por 24 horas.
model IdempotencyKey {
  key       String   @id @map("key") @db.VarChar(100)
  method    String   @map("method") @db.VarChar(10)
  path      String   @map("path") @db.VarChar(255)
  status    Int?     @map("status")
  body      Json?    @map("body")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("idempotency_keys")
}

/// Espécie: vocabulário fechado, dirigido por dados (009). Nome único sem diferenciar maiúsculas (SQL cru).
model Species {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name") @db.VarChar(80)
  version   Int      @default(0) @map("version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  pets      Pet[]

  @@map("species")
}

/// Animal: sempre dentro do dono (P1). Nome único por dono sem diferenciar maiúsculas (SQL cru).
model Pet {
  id        Int      @id @default(autoincrement()) @map("id")
  ownerId   Int      @map("owner_id")
  name      String   @map("name") @db.VarChar(30)
  birthDate DateTime @map("birth_date") @db.Date
  speciesId Int      @map("species_id")
  /// D09: active | deceased | transferred
  status    String   @default("active") @map("status") @db.VarChar(12)
  version   Int      @default(0) @map("version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Restrict, map: "pets_owner_id_fkey")
  species   Species  @relation(fields: [speciesId], references: [id], onDelete: Restrict, map: "pets_species_id_fkey")
  appointments Appointment[]
  encounters   Encounter[]

  @@index([ownerId], map: "pets_owner_id_idx")
  @@map("pets")
}

/// Agendamento (004, Pergunta 1): compromisso futuro do animal. Situações de D10.
model Appointment {
  id          Int      @id @default(autoincrement()) @map("id")
  petId       Int      @map("pet_id")
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(3)
  description String   @map("description") @db.VarChar(255)
  /// scheduled | done | cancelled | no_show
  status      String   @default("scheduled") @map("status") @db.VarChar(12)
  version     Int      @default(0) @map("version")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Restrict, map: "appointments_pet_id_fkey")
  changes     AppointmentStatusChange[]
  encounter   Encounter?

  @@index([petId, scheduledAt], map: "appointments_pet_id_scheduled_at_idx")
  @@map("appointments")
}

/// 004/T014: registro datado de cada mudança de situação; nunca apagado.
model AppointmentStatusChange {
  id            Int         @id @default(autoincrement()) @map("id")
  appointmentId Int         @map("appointment_id")
  fromStatus    String?     @map("from_status") @db.VarChar(12)
  toStatus      String      @map("to_status") @db.VarChar(12)
  changedAt     DateTime    @map("changed_at") @db.Timestamptz(3)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict, map: "appointment_status_changes_appointment_id_fkey")

  @@index([appointmentId], map: "appointment_status_changes_appointment_id_idx")
  @@map("appointment_status_changes")
}

/// Atendimento (004/T012, D26): entidade própria, imutável depois de registrada.
model Encounter {
  id             Int          @id @default(autoincrement()) @map("id")
  petId          Int          @map("pet_id")
  appointmentId  Int?         @unique(map: "encounters_appointment_id_key") @map("appointment_id")
  date           DateTime     @map("date") @db.Date
  chiefComplaint String       @map("chief_complaint") @db.VarChar(500)
  weightKg       Decimal?     @map("weight_kg") @db.Decimal(5, 2)
  diagnosis      String?      @map("diagnosis") @db.VarChar(2000)
  conduct        String?      @map("conduct") @db.VarChar(2000)
  returnDate     DateTime?    @map("return_date") @db.Date
  /// D01: veterinário opcional; a referência ao catálogo entra com a 005
  vetId          Int?         @map("vet_id")
  version        Int          @default(0) @map("version")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  pet            Pet          @relation(fields: [petId], references: [id], onDelete: Restrict, map: "encounters_pet_id_fkey")
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict, map: "encounters_appointment_id_fkey")

  @@index([petId, date], map: "encounters_pet_id_date_idx")
  @@map("encounters")
}

/// Veterinário (005): catálogo institucional; atende opcionalmente (D01).
model Vet {
  id          Int              @id @default(autoincrement()) @map("id")
  firstName   String           @map("first_name") @db.VarChar(30)
  lastName    String           @map("last_name") @db.VarChar(30)
  version     Int              @default(0) @map("version")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  specialties VetSpecialty[]

  @@map("vets")
}

model Specialty {
  id        Int            @id @default(autoincrement()) @map("id")
  name      String         @map("name") @db.VarChar(80)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  vets      VetSpecialty[]

  @@map("specialties")
}

/// Vínculo veterinário e especialidade: o par é único pela chave composta (Pergunta 6, C4).
model VetSpecialty {
  vetId       Int       @map("vet_id")
  specialtyId Int       @map("specialty_id")
  vet         Vet       @relation(fields: [vetId], references: [id], onDelete: Restrict, map: "vet_specialties_vet_id_fkey")
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict, map: "vet_specialties_specialty_id_fkey")

  @@id([vetId, specialtyId], map: "vet_specialties_pkey")
  @@map("vet_specialties")
}
